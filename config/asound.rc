# Clanker mix fragment — used as $HOME/.asoundrc (HOME=rockctl)
pcm.clanker_dmix {
    type dmix
    ipc_key 424242
    ipc_perm 0666
    slave {
        pcm "hw:0,0"
        format S32_LE
        rate 44100
        channels 2
        period_size 1024
        buffer_size 8192
    }
}
pcm.clanker {
    type plug
    slave.pcm "clanker_dmix"
}
# ~60% linear amplitude (~40% quieter) for music / ouch
pcm.clanker_quiet {
    type route
    slave.pcm "clanker"
    ttable.0.0 0.6
    ttable.1.1 0.6
}
